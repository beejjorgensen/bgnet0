<h1 id="foreword">Foreword</h1>
<!-- Beej's guide to Network Concepts
# vim: ts=4:sw=4:nosi:et:tw=72
-->
<!-- No hyphenation -->
<!-- \hyphenation{scalbn} -->
<!-- Index see alsos -->
<!--
